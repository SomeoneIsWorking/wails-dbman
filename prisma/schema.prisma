// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Connection {
  id        String   @id @default(uuid())
  name      String
  type      String
  host      String?
  port      Int?
  username  String?
  password  String?
  database  String?
  connectionString String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  databases         CachedDatabase[]
  schemas           CachedSchema[]
  queryHistories    QueryHistory[]

  @@map("connections")
}

model CachedDatabase {
  id           String     @id @default(uuid())
  connectionId String
  name         String
  updatedAt    DateTime   @updatedAt

  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, name])
  @@map("cached_databases")
}

model CachedSchema {
  id           String     @id @default(uuid())
  connectionId String
  database     String
  updatedAt    DateTime   @updatedAt

  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tables       CachedTable[]
  views        CachedView[]
  procedures   CachedProcedure[]

  @@unique([connectionId, database])
  @@map("cached_schemas")
}

model CachedTable {
  id           String     @id @default(uuid())
  schemaId     String
  name         String
  schema       String     // schema name
  updatedAt    DateTime   @updatedAt

  cachedSchema CachedSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  columns      CachedTableColumn[]
  primaryKeys  CachedTablePrimaryKey[]
  foreignKeys  CachedTableForeignKey[]

  @@unique([schemaId, schema, name])
  @@map("cached_tables")
}

model CachedTableColumn {
  id           String     @id @default(uuid())
  tableId      String
  name         String
  dataType     String
  isNullable   Boolean    @default(true)
  defaultValue String?
  isPrimary    Boolean    @default(false)
  isUnique     Boolean    @default(false)
  isForeign    Boolean    @default(false)
  comment      String?
  ordinalPosition Int

  table        CachedTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("cached_table_columns")
}

model CachedTablePrimaryKey {
  id           String     @id @default(uuid())
  tableId      String
  columnName   String
  ordinalPosition Int

  table        CachedTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("cached_table_primary_keys")
}

model CachedTableForeignKey {
  id                String     @id @default(uuid())
  tableId           String
  columnName        String
  referencedTable   String
  referencedColumn  String
  ordinalPosition   Int

  table             CachedTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("cached_table_foreign_keys")
}

model CachedView {
  id           String     @id @default(uuid())
  schemaId     String
  name         String
  schema       String     // schema name
  definition   String?    // view definition SQL
  updatedAt    DateTime   @updatedAt

  cachedSchema CachedSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  columns      CachedViewColumn[]

  @@unique([schemaId, schema, name])
  @@map("cached_views")
}

model CachedViewColumn {
  id           String     @id @default(uuid())
  viewId       String
  name         String
  dataType     String
  isNullable   Boolean    @default(true)
  defaultValue String?
  ordinalPosition Int

  view         CachedView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@map("cached_view_columns")
}

model QueryHistory {
  id           String     @id @default(uuid())
  connectionId String
  query        String
  result       String?    // JSON string
  error        String?
  executedAt   DateTime   @default(now())

  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("query_history")
}

model CachedProcedure {
  id                  String     @id @default(uuid())
  schemaId            String
  schema              String     // schema name
  procedureName       String
  definition          String?    // SQL content
  definitionReadError String?    // Error message if definition couldn't be read
  parametersCached    Boolean    @default(false)
  parametersReadError String?    // Error message if parameters couldn't be read
  resultSetsCached    Boolean    @default(false)
  resultSetsReadError String?    // Error message if result sets couldn't be read
  failedToLoad        Boolean    @default(false)
  failureReason       String?    // General error message if failed
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  cachedSchema        CachedSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  parameters          ProcedureParameter[]
  resultSets          ProcedureResultSet[]

  @@unique([schemaId, schema, procedureName])
  @@map("cached_procedures")
}

model ProcedureParameter {
  id           String     @id @default(uuid())
  procedureId  String
  name         String
  dataType     String
  direction    String     // IN, OUT, INOUT
  defaultValue String?
  isNullable   Boolean    @default(true)
  maxLength    Int?
  precision    Int?
  scale        Int?
  ordinalPosition Int

  procedure    CachedProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@map("procedure_parameters")
}

model ProcedureResultSet {
  id          String     @id @default(uuid())
  procedureId String
  resultSetIndex Int     // For procedures that return multiple result sets
  name        String?    // Result set name if available

  procedure   CachedProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  columns     ResultSetColumn[]

  @@map("procedure_result_sets")
}

model ResultSetColumn {
  id           String     @id @default(uuid())
  resultSetId  String
  name         String
  dataType     String
  isNullable   Boolean    @default(true)
  maxLength    Int?
  precision    Int?
  scale        Int?
  ordinalPosition Int

  resultSet    ProcedureResultSet @relation(fields: [resultSetId], references: [id], onDelete: Cascade)

  @@map("result_set_columns")
}
